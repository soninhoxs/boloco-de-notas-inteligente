# Mega Brain — produção (https://megabrain.app)
# Copie para .env no servidor Linux: cp .env.production.example .env

SITE_DOMAIN=megabrain.app

POSTGRES_DB=megabrain
POSTGRES_USER=megabrain
POSTGRES_PASSWORD=ALTERE_ESTA_SENHA_ANTES_DO_DEPLOY

MINIO_ROOT_USER=megabrain_minio
MINIO_ROOT_PASSWORD=ALTERE_ESTA_SENHA_ANTES_DO_DEPLOY
MINIO_BUCKET=attachments

JWT_SECRET=ALTERE_COM_openssl_rand_hex_32

# GitHub OAuth — callback: https://megabrain.app/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — callback: https://megabrain.app/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_DEFAULT_PROVIDER=groq

CONSENT_VERSION=2026-06-18

# E-mail transacional (verificação de conta, troca de e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@megabrain.app
